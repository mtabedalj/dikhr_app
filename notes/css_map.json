{
  "_comment": "Extracted from Athkar.app light.css/dark.css. Classes actually present in Dikhr's athkar_pages.json + original athkarList.plist: quran, left, noHide (span), Left (span), plain span; plus h3, small, strong, br, hr tags. 'mashy'/'trans'/'translation' do NOT appear in the athkar data.",
  "_font_facs": {
    "QuranFont@font-face": "UthmanicHafs_V22_Bold.ttf (postScript: KFGQPCHAFSUthmanicScript-Bold)",
    "NewQuran@font-face": "Scheherazade-Regular.ttf (postScript: Scheherazade-Regular)",
    "ExpoArabic-Book@font-face": "ExpoArabic-Book.ttf (postScript: ExpoArabic-Book)"
  },
  "classes": {
    "body (main thikr text)": {
      "light": {
        "background-color": "transparent",
        "font-weight": "bold",
        "font-family": "HelveticaNeue",
        "margin": "auto",
        "padding": "20px",
        "margin-top": "10px"
      },
      "dark": {
        "/\n    background-color": "transparent",
        "font-weight": "bold",
        "padding": "20px",
        "font-family": "HelveticaNeue",
        "margin": "auto",
        "margin-top": "10px",
        "color": "#f0f0f0"
      }
    },
    "#main": {
      "light": {
        "color": "#000",
        "line-height": "25px"
      },
      "dark": {
        "color": "#ececec",
        "line-height": "25px"
      }
    },
    ".quran (div block)": {
      "light": {
        "font-family": "'QuranFont'",
        "font-weight": "normal",
        "word-spacing": "1",
        "font-size": "125%",
        "\u0013 vertical-align": "text-bottom",
        "line-height": "1.75"
      },
      "dark": {
        "font-family": "'QuranFont'",
        "font-weight": "normal",
        "word-spacing": "1",
        "/\n    font-size": "125%",
        "\u0013 vertical-align": "text-bottom",
        "line-height": "1.75"
      }
    },
    ".newQuran": {
      "light": {
        "font-family": "'QuranFont'",
        "font-weight": "normal",
        "word-spacing": "1",
        "font-size": "150%",
        "\u0013 vertical-align": "text-bottom",
        "line-height": "1.2"
      },
      "dark": {
        "font-family": "'QuranFont'",
        "font-weight": "normal",
        "word-spacing": "1",
        "font-size": "150%",
        "\u0013 vertical-align": "text-bottom",
        "line-height": "1.2"
      }
    },
    ".newQuran b": {
      "light": {
        "font-weight": "normal",
        "color": "#00946a"
      },
      "dark": {
        "font-weight": "normal",
        "color": "#00946a"
      }
    },
    "#main span.quran / span.quran (color override)": {
      "light": {
        "color": "#000"
      },
      "dark": {
        "color": "#f0f0f0"
      }
    },
    "#main span (attributions, noHide, notes)": {
      "light": {
        "color": "#003976"
      },
      "dark": {
        "color": "#0aa3c8"
      }
    },
    ".english": {
      "light": {
        "font-size": "80%"
      },
      "dark": {
        "font-size": "80%"
      }
    },
    ".english span": {
      "light": {
        "color": "#003976"
      },
      "dark": {
        "color": "#0aa3c8"
      }
    },
    ".translation": {
      "light": {
        "color": "#00946a"
      },
      "dark": {
        "color": "#00946a"
      }
    },
    ".news": {
      "light": {
        "background-color": "transparent",
        "font-weight": "normal",
        "margin-top": "0px",
        "color": "#000",
        "font-family": "'-apple-system'",
        "font-size": "17px",
        "text-align": "justify",
        "direction": "rtl"
      },
      "dark": {
        "background-color": "transparent",
        "font-weight": "normal",
        "margin-top": "0px",
        "color": "#FFF",
        "font-family": "'-apple-system'",
        "font-size": "17px",
        "text-align": "justify",
        "direction": "rtl"
      }
    },
    "h3 (bismillah heading)": {
      "light": {
        "font": "bold 12pt",
        "font-size": "12pt",
        "margin-top": "0px",
        "color": "#003976"
      },
      "dark": {
        "font": "bold 12pt",
        "font-size": "12pt",
        "color": "#0aa3c8",
        "margin-top": "0px"
      }
    },
    "p.left (repetition count line)": {
      "light": {
        "background-color": "transparent",
        "color": "#000",
        "padding": "5px",
        "font-family": "'ExpoArabic-Book'",
        "font-size": "11px",
        "text-align": "center",
        "width": "98%",
        "float": "left",
        "border-top": "solid 1px #666"
      },
      "dark": {
        "background-color": "transparent",
        "color": "#fff",
        "padding": "4px",
        "font-family": "'ExpoArabic-Book'",
        "font-size": "11px",
        "text-align": "center",
        "width": "98%",
        "float": "left",
        "border-top": "solid 1px #7d7d7d"
      }
    },
    "a.button": {
      "light": {
        "webkit-border-radius": "3",
        "moz-border-radius": "3",
        "border-radius": "3px",
        "font-family": "'ExpoArabic-Book'",
        "color": "#00946a",
        "font-size": "14px",
        "background": "#ebfff9",
        "padding": "10px",
        "border": "solid #00946a 1px",
        "text-decoration": "none"
      },
      "dark": {
        "webkit-border-radius": "3",
        "moz-border-radius": "3",
        "border-radius": "3px",
        "font-family": "'ExpoArabic-Book'",
        "color": "#000",
        "font-size": "14px",
        "background": "#ddd",
        "padding": "10px",
        "border": "solid #000 1px",
        "text-decoration": "none"
      }
    },
    "#allahNames": {
      "light": {
        "color": "#000",
        "line-height": "25px"
      },
      "dark": {
        "color": "#ececec",
        "line-height": "25px"
      }
    },
    "#allahNames abbr": {
      "light": {
        "color": "#003976"
      },
      "dark": {
        "color": "#0aa3c8"
      }
    },
    ".highlight": {
      "light": {
        "background-color": "yellow"
      },
      "dark": {
        "background-color": "yellow"
      }
    }
  }
}